PROGRAM GN_UD_INP_F9

%COMMENT = 'Copy PR[5] to PR[190]'
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE

%ENVIRONMENT REGOPE
%ENVIRONMENT STRNG

VAR
   stat : INTEGER
   POS  : POSITION
   txt  : STRING[32]

-- =========================================
-- ROUTINE: COPY_PR
-- =========================================
ROUTINE COPY_PR(target_pr : INTEGER)

VAR
   stat : INTEGER

BEGIN

   POS = GET_POS_REG(5, stat);

   IF stat <> 0 THEN
      WRITE('Error reading PR[5], status=', stat, CR);
      RETURN;
   ENDIF;

   SET_POS_REG(target_pr, POS, stat);

   IF stat <> 0 THEN
      WRITE('Error writing PR[', target_pr, '], status=', stat, CR);
      RETURN;
   ENDIF;

   WRITE('PR[', target_pr, '] copied from PR[1]', CR);

END COPY_PR;   -- ? FIX HERE

-- =========================================
-- MAIN
-- =========================================
BEGIN

   WRITE('Copying PR[5] to PR[190] !', CR);

   COPY_PR(190);

   WRITE('Initial Infeed position updated !', CR);

   txt = 'Infeed Position Top';
   SET_REG_CMT(190, txt, stat);

END GN_UD_INP_F9
