PROGRAM GN_CK_PAL_F9

%COMMENT = 'Read 4 pallets / 6 origins'
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE

%ENVIRONMENT REGOPE
%ENVIRONMENT STRNG
%ENVIRONMENT SYSDEF

CONST
   REG_IN_ID = 403

   DB_BASE   = 600
   DB_STRIDE = 43
   DB_ITEMS  = 4

   OUT_BASE  = 422
   DATA_CNT  = 42

   SR_STAT   = 43

VAR
   sel_id     : REAL
   db_id      : REAL

   i          : INTEGER
   j          : INTEGER
   status     : INTEGER
   dummy      : INTEGER
   base_match : INTEGER

   found      : BOOLEAN
   is_real    : BOOLEAN

   i_val      : INTEGER
   r_val      : REAL

   buf42_r     : ARRAY[42] OF REAL
   buf42_i     : ARRAY[42] OF INTEGER

BEGIN

   found = FALSE
   base_match = 0

   -- Default result until a matching ID is found
   SET_STR_REG(SR_STAT,'NOT FOUND',dummy)

   -- Register comments
   SET_REG_CMT(REG_IN_ID,'PALLET_ID',status)

   SET_REG_CMT(422,'PALLET_ROWS',status)
   SET_REG_CMT(423,'PALLET_COLS',status)
   SET_REG_CMT(424,'ROW_PITCH [mm]',status)
   SET_REG_CMT(425,'COL_PITCH [mm]',status)
   SET_REG_CMT(426,'LAYER_HEIGHT [mm]',status)
   SET_REG_CMT(427,'PALLET_SLOTS',status)

   SET_REG_CMT(428,'INF1X_ORG [mm]',status)
   SET_REG_CMT(429,'INF1Y_ORG [mm]',status)
   SET_REG_CMT(430,'INF1Z_ORG [mm]',status)
   SET_REG_CMT(431,'INF1A_ORG [deg]',status)
   SET_REG_CMT(432,'INF1G_ORG [deg]',status)
   SET_REG_CMT(433,'INF1B_ORG [deg]',status)

   SET_REG_CMT(434,'INF2X_ORG [mm]',status)
   SET_REG_CMT(435,'INF2Y_ORG [mm]',status)
   SET_REG_CMT(436,'INF2Z_ORG [mm]',status)
   SET_REG_CMT(437,'INF2A_ORG [deg]',status)
   SET_REG_CMT(438,'INF2G_ORG [deg]',status)
   SET_REG_CMT(439,'INF2B_ORG [deg]',status)

   SET_REG_CMT(440,'INF3X_ORG [mm]',status)
   SET_REG_CMT(441,'INF3Y_ORG [mm]',status)
   SET_REG_CMT(442,'INF3Z_ORG [mm]',status)
   SET_REG_CMT(443,'INF3A_ORG [deg]',status)
   SET_REG_CMT(444,'INF3B_ORG [deg]',status)
   SET_REG_CMT(445,'INF3G_ORG [deg]',status)

   SET_REG_CMT(446,'OTF1X_ORG [mm]',status)
   SET_REG_CMT(447,'OTF1Y_ORG [mm]',status)
   SET_REG_CMT(448,'OTF1Z_ORG [mm]',status)
   SET_REG_CMT(449,'OTF1A_ORG [deg]',status)
   SET_REG_CMT(450,'OTF1B_ORG [deg]',status)
   SET_REG_CMT(451,'OTF1G_ORG [deg]',status)

   SET_REG_CMT(452,'OTF2X_ORG [mm]',status)
   SET_REG_CMT(453,'OTF2Y_ORG [mm]',status)
   SET_REG_CMT(454,'OTF2Z_ORG [mm]',status)
   SET_REG_CMT(455,'OTF2A_ORG [deg]',status)
   SET_REG_CMT(456,'OTF2B_ORG [deg]',status)
   SET_REG_CMT(457,'OTF2G_ORG [deg]',status)

   SET_REG_CMT(458,'OTF3X_ORG [mm]',status)
   SET_REG_CMT(459,'OTF3Y_ORG [mm]',status)
   SET_REG_CMT(460,'OTF3Z_ORG [mm]',status)
   SET_REG_CMT(461,'OTF3A_ORG [deg]',status)
   SET_REG_CMT(462,'OTF3B_ORG [deg]',status)
   SET_REG_CMT(463,'OTF3G_ORG [deg]',status)

   -- Read requested pallet ID
   GET_REG(REG_IN_ID,is_real,i_val,r_val,status)

   IF status <> 0 THEN
      WRITE('INPUT READ ERROR',CR)
      RETURN
   ENDIF

   IF is_real THEN
      sel_id = r_val
   ELSE
      sel_id = i_val
   ENDIF

   IF sel_id <= 0 THEN
      WRITE('INVALID PALLET ID',CR)
      RETURN
   ENDIF

   IF sel_id <> TRUNC(sel_id) THEN
      WRITE('INVALID PALLET ID',CR)
      RETURN
   ENDIF

   -- Search bases: 600, 643, 686, 729
   FOR i = 1 TO DB_ITEMS DO
      IF NOT found THEN

         GET_REG(DB_BASE + ((i-1) * DB_STRIDE),
                 is_real,i_val,r_val,status)

         -- Skip unreadable records and continue searching
         IF status = 0 THEN

            IF is_real THEN
               db_id = r_val
            ELSE
               db_id = i_val
            ENDIF

            IF db_id = sel_id THEN
               found = TRUE
               base_match = DB_BASE + ((i-1) * DB_STRIDE)
            ENDIF

         ELSE
            WRITE('DATABASE ID READ ERROR',CR)
         ENDIF

      ENDIF
   ENDFOR

   IF NOT found THEN
      WRITE('PALLET ID NOT FOUND',CR)
      RETURN
   ENDIF

   -- ID found: keep this result even if data loading fails
   SET_STR_REG(SR_STAT,'OK',dummy)

   -- Read all 42 fields before writing outputs
   FOR j = 1 TO DATA_CNT DO

      GET_REG(base_match + j,
              is_real,i_val,r_val,status)

      IF status <> 0 THEN
         WRITE('DATA READ ERROR',CR)
         RETURN
      ENDIF

      -- Rows, columns and slots must be whole numbers
      IF (j = 1) OR (j = 2) OR (j = 6) THEN

         IF is_real THEN
            IF r_val < 0 THEN
               WRITE('INVALID PALLET COUNT',CR)
               RETURN
            ENDIF

            IF r_val <> TRUNC(r_val) THEN
               WRITE('INVALID PALLET COUNT',CR)
               RETURN
            ENDIF

            buf42_i[j] = TRUNC(r_val)
         ELSE
            IF i_val < 0 THEN
               WRITE('INVALID PALLET COUNT',CR)
               RETURN
            ENDIF

            buf42_i[j] = i_val
         ENDIF

      ELSE
         IF is_real THEN
            buf42_r[j] = r_val
         ELSE
            buf42_r[j] = i_val
         ENDIF
      ENDIF

   ENDFOR

   -- Write selected pallet data to R[422]..R[463]
   FOR j = 1 TO DATA_CNT DO

      IF (j = 1) OR (j = 2) OR (j = 6) THEN
         SET_INT_REG(OUT_BASE + j - 1,buf42_i[j],status)
      ELSE
         SET_REAL_REG(OUT_BASE + j - 1,buf42_r[j],status)
      ENDIF

      IF status <> 0 THEN
         WRITE('OUTPUT WRITE ERROR',CR)
         RETURN
      ENDIF

   ENDFOR

   WRITE('PALLET DATA LOADED SUCCESSFULLY',CR)

END GN_CK_PAL_F9


