PROGRAM GN_CK_PAL_F9

%COMMENT = 'Read 5 pallets / 6 origins'
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE

%ENVIRONMENT REGOPE
%ENVIRONMENT STRNG
%ENVIRONMENT SYSDEF

CONST
   REG_IN_ID = 403

   DB_BASE   = 600
   DB_STRIDE = 25
   DB_ITEMS  = 5

   OUT_BASE  = 422
   DATA_CNT  = 24

   SR_STAT   = 43

VAR
   sel_id     : REAL
   db_id      : REAL

   i          : INTEGER
   j          : INTEGER
   status     : INTEGER
   dummy      : INTEGER
   base_match : INTEGER

   found      : BOOLEAN
   is_real    : BOOLEAN

   i_val      : INTEGER
   r_val      : REAL

   buf24_r     : ARRAY[24] OF REAL
   buf24_i     : ARRAY[24] OF INTEGER

BEGIN

   found = FALSE
   base_match = 0

   -- Default result until a matching ID is found
   SET_STR_REG(SR_STAT,'NOT FOUND',dummy)

   -- Register comments
   SET_REG_CMT(REG_IN_ID,'PALLET_ID',status)

   SET_REG_CMT(422,'PALLET_ROWS',status)
   SET_REG_CMT(423,'PALLET_COLS',status)
   SET_REG_CMT(424,'ROW_PITCH [mm]',status)
   SET_REG_CMT(425,'COL_PITCH [mm]',status)
   SET_REG_CMT(426,'LAYER_HEIGHT [mm]',status)
   SET_REG_CMT(427,'PALLET_SLOTS',status)

   SET_REG_CMT(428,'INF1X_ORG [mm]',status)
   SET_REG_CMT(429,'INF1Y_ORG [mm]',status)
   SET_REG_CMT(430,'INF1Z_ORG [mm]',status)

   SET_REG_CMT(431,'INF2X_ORG [mm]',status)
   SET_REG_CMT(432,'INF2Y_ORG [mm]',status)
   SET_REG_CMT(433,'INF2Z_ORG [mm]',status)

   SET_REG_CMT(434,'INF3X_ORG [mm]',status)
   SET_REG_CMT(435,'INF3Y_ORG [mm]',status)
   SET_REG_CMT(436,'INF3Z_ORG [mm]',status)

   SET_REG_CMT(437,'OTF1X_ORG [mm]',status)
   SET_REG_CMT(438,'OTF1Y_ORG [mm]',status)
   SET_REG_CMT(439,'OTF1Z_ORG [mm]',status)

   SET_REG_CMT(440,'OTF2X_ORG [mm]',status)
   SET_REG_CMT(441,'OTF2Y_ORG [mm]',status)
   SET_REG_CMT(442,'OTF2Z_ORG [mm]',status)

   SET_REG_CMT(443,'OTF3X_ORG [mm]',status)
   SET_REG_CMT(444,'OTF3Y_ORG [mm]',status)
   SET_REG_CMT(445,'OTF3Z_ORG [mm]',status)

   -- Read requested pallet ID
   GET_REG(REG_IN_ID,is_real,i_val,r_val,status)

   IF status <> 0 THEN
      WRITE('INPUT READ ERROR',CR)
      RETURN
   ENDIF

   IF is_real THEN
      sel_id = r_val
   ELSE
      sel_id = i_val
   ENDIF

   IF sel_id <= 0 THEN
      WRITE('INVALID PALLET ID',CR)
      RETURN
   ENDIF

   IF sel_id <> TRUNC(sel_id) THEN
      WRITE('INVALID PALLET ID',CR)
      RETURN
   ENDIF

   -- Search bases: 600, 625, 650, 675, 700
   FOR i = 1 TO DB_ITEMS DO
      IF NOT found THEN

         GET_REG(DB_BASE + ((i-1) * DB_STRIDE),
                 is_real,i_val,r_val,status)

         -- Skip unreadable records and continue searching
         IF status = 0 THEN

            IF is_real THEN
               db_id = r_val
            ELSE
               db_id = i_val
            ENDIF

            IF db_id = sel_id THEN
               found = TRUE
               base_match = DB_BASE + ((i-1) * DB_STRIDE)
            ENDIF

         ELSE
            WRITE('DATABASE ID READ ERROR',CR)
         ENDIF

      ENDIF
   ENDFOR

   IF NOT found THEN
      WRITE('PALLET ID NOT FOUND',CR)
      RETURN
   ENDIF

   -- ID found: keep this result even if data loading fails
   SET_STR_REG(SR_STAT,'OK',dummy)

   -- Read all 24 fields before writing outputs
   FOR j = 1 TO DATA_CNT DO

      GET_REG(base_match + j,
              is_real,i_val,r_val,status)

      IF status <> 0 THEN
         WRITE('DATA READ ERROR',CR)
         RETURN
      ENDIF

      -- Rows, columns and slots must be whole numbers
      IF (j = 1) OR (j = 2) OR (j = 6) THEN

         IF is_real THEN
            IF r_val < 0 THEN
               WRITE('INVALID PALLET COUNT',CR)
               RETURN
            ENDIF

            IF r_val <> TRUNC(r_val) THEN
               WRITE('INVALID PALLET COUNT',CR)
               RETURN
            ENDIF

            buf24_i[j] = TRUNC(r_val)
         ELSE
            IF i_val < 0 THEN
               WRITE('INVALID PALLET COUNT',CR)
               RETURN
            ENDIF

            buf24_i[j] = i_val
         ENDIF

      ELSE
         IF is_real THEN
            buf24_r[j] = r_val
         ELSE
            buf24_r[j] = i_val
         ENDIF
      ENDIF

   ENDFOR

   -- Write selected pallet data to R[422]..R[445]
   FOR j = 1 TO DATA_CNT DO

      IF (j = 1) OR (j = 2) OR (j = 6) THEN
         SET_INT_REG(OUT_BASE + j - 1,buf24_i[j],status)
      ELSE
         SET_REAL_REG(OUT_BASE + j - 1,buf24_r[j],status)
      ENDIF

      IF status <> 0 THEN
         WRITE('OUTPUT WRITE ERROR',CR)
         RETURN
      ENDIF

   ENDFOR

   WRITE('PALLET DATA LOADED SUCCESSFULLY',CR)

END GN_CK_PAL_F9
