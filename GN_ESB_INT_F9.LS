/PROG  GN_ESB_INT_F9
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "ESB INITIALIZATION";
PROG_SIZE	= 3071;
CREATE		= DATE 29-01-26  TIME 08:00:00;
MODIFIED	= DATE 29-01-26  TIME 08:00:00;
FILE_NAME	= GN_ESB_INT_F9;
VERSION		= 0;
LINE_COUNT	= 100;
MEMORY_SIZE	= 3515;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= 1,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
   1:  ! ===================================== ;
   2:  ! INITIALIZATION & RESET                ;
   3:  ! ===================================== ;
   4:  ! ---- Reset Robot Status Registers ---- ;
   5:  R[8:MZ_RUN]=0 ;
   6:  R[10:RUN_STATUS]=0 ;
   7:  ! ---- Reset Outputs (Robot -> Cell) ---- ;
   8:  DO[27:ROBOT READY R]=ON ;
   9:  DO[30:ROBOT FAULT (UOP)]=OFF ;
  10:  DO[31:DOOR OPEN R COMMAND]=OFF ;
  11:  DO[32:DOOR CLOSE R COMMAND]=OFF ;
  12:  DO[9:ROBOT EMG. R]=ON ;
  13:  ! ---- Reset End Effector ---- ;
  14:  RO[1:GRIPPER CLOSE]=OFF ;
  15:  ! ---- Set String Registers ---- ;
  16:  CALL GN_SET_RG_F9 ;
  17:  ;
  18:  ! ===================================== ;
  19:  ! USER PARAMETERS                       ;
  20:  ! ===================================== ;
  21:  R[86:Grab_Offset_Move]=10 ;
  22:  R[701:Grab_Offset_Dist]=2 ;
  23:  !R[700:GRAB_MODE_SELECT]=0 for AUTO & R[700]=1 for MANUAL ;
  24:  R[700:GRAB_MODE_SELECT]=0 ;
  25:  ;
  26:  ! ===================================== ;
  27:  ! INITIALIZED STATE                     ;
  28:  ! ===================================== ;
  29:  LBL[1:INITIALIZED] ;
  30:  ! ---- Set Tool & User Frame ---- ;
  31:  UFRAME_NUM=0 ;
  32:  UTOOL_NUM=1 ;
  33:  ! ---- Move Robot to Home Position ---- ;
  34:  J PR[1:HOME.U0] 50% FINE ;
  35:  MESSAGE[Robot is at home position.] ;
  36:  WAIT 2.00(sec) ;
  37:  ! ---- Clear Teach Pendant Screen ---- ;
  38:  CALL GN_CLS_SC_F9 ;
  39:  ! ---- Operator / HMI Messages ---- ;
  40:  MESSAGE[GN CORP - FRONTIER 09] ;
  41:  MESSAGE[MAIN PROGRAM STARTING.] ;
  42:  WAIT 3.00(sec) ;
  43:  ;
  44:  ! ===================================== ;
  45:  ! LOAD PART EOAT PALLET DATA            ;
  46:  ! ===================================== ;
  47:  LBL[2:LOAD_DATA] ;
  48:  CALL GN_ESB_SET_CYL_DATA_F9 ;
  49:  CALL GN_ESB_SET_EOAT_DAT_F9 ;
  50:  CALL GN_ESB_SET_PALT_DAT_F9 ;
  51:  ;
  52:  ! ===================================== ;
  53:  ! ASKING ID DATA FROM USER              ;
  54:  ! ===================================== ;
  55:  LBL[3:ASK_DATA] ;
  56:  CALL GN_ASK_ID_F9 ;
  57:  CALL GN_CK_PRT_F9 ;
  58:  CALL GN_CK_EOT_F9 ;
  59:  CALL GN_CK_PAL_F9 ;
  60:  ;
  61:  ! ===================================== ;
  62:  ! CHECK PART ID FROM USER               ;
  63:  ! ===================================== ;
  64:  IF SR[41:PART Status]=SR[40:Status Result],JMP LBL[4] ;
  65:  MESSAGE[INVALID PART ID - TRY AGAIN] ;
  66:  WAIT 3.00(sec) ;
  67:  JMP LBL[3] ;
  68:  ;
  69:  ! ===================================== ;
  70:  ! PART ID OK                            ;
  71:  ! ===================================== ;
  72:  LBL[4:PART_ID_OK] ;
  73:  CALL GN_CLS_SC_F9 ;
  74:  MESSAGE[PART ID FOUND.] ;
  75:  WAIT 3.00(sec) ;
  76:  ;
  77:  ! ===================================== ;
  78:  ! CHECK EOAT ID FROM USER               ;
  79:  ! ===================================== ;
  80:  IF SR[42:EOAT Status]=SR[40:Status Result],JMP LBL[5] ;
  81:  MESSAGE[INVALID EOAT ID - TRY AGAIN] ;
  82:  WAIT 3.00(sec) ;
  83:  JMP LBL[3] ;
  84:  ;
  85:  ! ===================================== ;
  86:  ! EOAT ID OK                            ;
  87:  ! ===================================== ;
  88:  LBL[5:EOAT_ID_OK] ;
  89:  CALL GN_CLS_SC_F9 ;
  90:  MESSAGE[EOAT ID FOUND.] ;
  91:  WAIT 3.00(sec) ;
  92:  ;
  93:  ! ===================================== ;
  94:  ! CHECK PALLET ID FROM USER             ;
  95:  ! ===================================== ;
  96:  IF SR[43:PALLET Status]=SR[40:Status Result],JMP LBL[6] ;
  97:  MESSAGE[INVALID PALLET ID - TRY AGAIN] ;
  98:  WAIT 3.00(sec) ;
  99:  JMP LBL[3] ;
 100:  ;
 101:  ! ===================================== ;
 102:  ! PALLET ID OK                          ;
 103:  ! ===================================== ;
 104:  LBL[6:PALLET_ID_OK] ;
 105:  CALL GN_CLS_SC_F9 ;
 106:  MESSAGE[PALLET ID FOUND.] ;
 107:  CALL GN_RED_PO_F9 ;
 108:  WAIT 3.00(sec) ;
 109:  ;
 110:  ! ===================================== ;
 111:  ! CHECK PALLET SLOTS                    ;
 112:  ! ===================================== ;
 113:  CALL GN_CK_PNM_F9 ;
 114:  IF SR[44:PNM Status]=SR[40:Status Result],JMP LBL[7] ;
 115:  MESSAGE[INVALID PARTS NUM - TRY AGAIN] ;
 116:  WAIT 3.00(sec) ;
 117:  JMP LBL[3] ;
 118:  ;
 119:  ! ===================================== ;
 120:  ! PALLET SLOTS OK                       ;
 121:  ! ===================================== ;
 122:  LBL[7:PALLET_SLOTS_OK] ;
 123:  CALL GN_CLS_SC_F9 ;
 124:  MESSAGE[PALLET and PARTS NUM is OK.] ;
 125:  WAIT 3.00(sec) ;
 126:  CALL GN_CLS_SC_F9 ;
 127:  ;
 128:  ! ===================================== ;
 129:  ! SETTING INITIAL POSITION REGISTERS    ;
 130:  ! ===================================== ;
 131:  LBL[8:Pre_Inf_Reg] ;
 132:  UFRAME_NUM=0 ;
 133:  UTOOL_NUM=1 ;
 134:  J PR[5:PREINFEED.U0] 50% CNT50 ;
 135:  MESSAGE[Robot is at infeed position.] ;
 136:  CALL GN_ESB_SET_INT_PREG_F9 ;
 137:  MESSAGE[SET INFD POSs.] ;
 138:  WAIT 3.00(sec) ;
 139:  CALL GN_CLS_SC_F9 ;
 140:  ;
 141:  ! ===================================== ;
 142:  ! PRE-INFEED MOVEMENT                   ;
 143:  ! ===================================== ;
 144:  UFRAME_NUM=12 ;
 145:  UTOOL_NUM=1 ;
 146:  J PR[190:INFEED POSITION TOP] 50% CNT50 ;
 147:  MESSAGE[Robot at infd pos top.] ;
 148:  WAIT 2.00(sec) ;
 149:  CALL GN_CLS_SC_F9 ;
 150:  ;
 151:  ! ===================================== ;
 152:  ! PRE-INFEED REQUIREMENTS               ;
 153:  ! ===================================== ;
 154:  LBL[9:Pre_Inf_Cnd] ;
 155:  WAIT DI[1:SERVICE CALL M]=ON ;
 156:  DO[7:SERVICE CALL FIN R]=ON ;
 157:  WAIT 0.50(sec) ;
 158:  WAIT DI[1:SERVICE CALL M]=OFF ;
 159:  DO[7:SERVICE CALL FIN R]=OFF ;
 160:  DO[2:HD2 SELECT R]=OFF ;
 161:  DO[1:HD1 SELECT R]=ON ;
 162:  WAIT 0.50(sec) ;
 163:  ;
 164:  ! ===================================== ;
 165:  ! INFEED                                ;
 166:  ! ===================================== ;
 167:  CALL GN_CLS_SC_F9 ;
 168:  MESSAGE[INFEED operation starts.] ;
 169:  ! CALL GN_ESB_INFEED_F9 ;
/POS
/END

