/PROG  GN_ESB_MAIN_F9
/ATTR
OWNER         = MNEDITOR;
COMMENT       = "ESB MAIN PROGRAM";
PROG_SIZE     = 3071;
CREATE        = DATE 14-09-2026 TIME 15:00:00;
MODIFIED      = DATE 14-09-2026 TIME 15:00:00;
FILE_NAME     = GN_ESB_MAIN_F9;
VERSION       = 0;
LINE_COUNT    = 171;
MEMORY_SIZE   = 3700;
PROTECT       = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  ! INITIALIZE I/O AND REGISTERS ;
   2:  DO[27:ON ]=ON ;
   3:  DO[30:OFF]=OFF ;
   4:  DO[31:OFF]=OFF ;
   5:  R[8]=0 ;
   6:  R[10]=0 ;
   7:  RO[1:OFF]=OFF ;
   8:  DO[31:OFF]=OFF ;
   9:  DO[32:OFF]=OFF ;
  10:  DO[9:ON ]=ON ;
  11:  ! ---------------------------- ;
  12:  ! INITIALIZE ESB REGISTERS ;
  13:  ! ---------------------------- ;
  14:  CALL GN_CLS_SC_F9 ;
  19:  CALL GN_SET_RG_F9 ;
  20:  CALL GN_ESB_ASK_F9 ;
  21:  ! ---------------------------- ;
  22:  ! INITIALIZED STATE ;
  23:  ! ---------------------------- ;
  24:  LBL[1:INITIALIZED] ;
  25:  ! SET USER FRAME AND TOOL ;
  26:  UFRAME_NUM=0 ;
  27:  UTOOL_NUM=1 ;
  28:  ! MOVE ROBOT TO HOME POSITION ;
  29:  J PR[1:HOME.U0] 50% FINE ;
  30:  MESSAGE[Robot is at home position.] ;
  31:  WAIT 2.00(sec) ;
  32:  ! CLEAR TEACH PENDANT SCREEN ;
  33:  CALL GN_CLS_SC_F9 ;
  34:  ! DISPLAY STARTUP MESSAGES ;
  35:  MESSAGE[GN CORP - FRONTIER 09] ;
  36:  MESSAGE[MAIN PROGRAM STARTING.] ;
  37:  WAIT 3.00(sec) ;
  38:  ;
  39:  ! ---------------------------- ;
  40:  LBL[2:CHECK_RUN] ;
  41:  IF R[20]>=400,JMP LBL[1] ;
  42:  IF R[10]=1 OR R[10]=2,JMP LBL[41] ;
  43:  ;
  44:  ! CHECK MAZAK RUN CONDITIONS ;
  45:  IF DI[22:ON ]=OFF OR DI[19:ON ]=OFF,JMP LBL[1] ;
  46:  ! ---------------------------- ;
  47:  LBL[5:PRE_INFEED] ;
  48:  WAIT DI[1:OFF]=ON ;
  49:  DO[7:OFF]=ON ;
  50:  WAIT .50(sec) ;
  51:  WAIT DI[1:OFF]=OFF ;
  52:  DO[7:OFF]=OFF ;
  53:  DO[2:OFF]=OFF ;
  54:  DO[1:OFF]=ON ;
  55:  WAIT .50(sec) ;
  56:  ;
  57:  ! CHECK BAR FEED MODE ;
  58:  IF (R[3]=1) THEN ;
  59:    JMP LBL[10] ;
  60:  ELSE ;
  61:    CALL GN_INFEED_999 ;
  62:  ENDIF ;
  63:  ;
  64:  IF DI[14:OFF]=ON AND DI[10:OFF]=OFF,JMP LBL[1] ;
  65:  J PR[10] 100% CNT50 ;
  66:  ! ---------------------------- ;
  67:  WAIT DI[18:ON ]=OFF ;
  68:  IF R[10]=3 AND DI[18:ON ]=OFF AND DI[22:ON ]=ON AND DI[19:ON ]=ON AND DI[25:ON ]=ON,JMP LBL[10] ;
  69:  ;
  70:  LBL[10: CHECK_DOOR] ;
  71:  ! OPEN MAZAK DOOR ;
  72:  IF DI[24:OFF]=ON,JMP LBL[20] ;
  73:  DO[32:OFF]=OFF ;
  74:  DO[31:OFF]=ON ;
  75:  WAIT DI[24:OFF]=ON ;
  76:  DO[31:OFF]=OFF ;
  77:  IF DI[24:OFF]=OFF,JMP LBL[90] ;
  78:  ;
  79:  ! CHECK BAR FEED MODE ;
  80:  IF (R[3]=1) THEN ;
  81:    JMP LBL[20] ;
  82:  ELSE ;
  83:    JMP LBL[11] ;
  84:  ENDIF ;
  85:  ;
  86:  ! ---------------------------- ;
  87:  ! CHECK FOR WORKPIECE IN CHUCK ;
  88:  ;
  89:  LBL[11: CHECK_WORKPIECE] ;
  90:  DO[2:OFF]=OFF ;
  91:  DO[1:OFF]=ON ;
  92:  IF (DI[11:OFF]=ON AND DI[14:OFF]=ON) THEN ;
  93:    JMP LBL[9999] ;
  94:  ENDIF ;
  95:  ! ---------------------------- ;
  96:  ;
  97:  LBL[20:MOVE_TO_MZ] ;
  98:  UFRAME_NUM=0 ;
  99:  J PR[10] 100% CNT50 ;
 100:  J PR[11] 100% FINE ;
 101:  ;
 102:  ! CHECK BAR FEED MODE ;
 103:  IF (R[3]=1) THEN ;
 104:    JMP LBL[22] ;
 105:  ELSE ;
 106:    JMP LBL[21] ;
 107:  ENDIF ;
 108:  ;
 109:  ! ---------------------------- ;
 110:  LBL[21:LOAD_MZ] ;
 111:  UFRAME_NUM=3 ;
 112:  CALL GN_LOAD_991 ;
 113:  ;
 114:  ! ---------------------------- ;
 115:  LBL[22:UNLOAD_MZ] ;
 116:  CALL GN_UNLOAD_999 ;
 117:  ;
 118:  ! MOVE TO PRE-MAZAK POSITION ;
 119:  UFRAME_NUM=0 ;
 120:  J PR[21] 75% FINE ;
 121:  IF R[20]>300,JMP LBL[24] ;
 122:  R[8]=1 ;
 123:  DO[31:OFF]=OFF ;
 124:  DO[32:OFF]=PULSE,10.0sec ;
 125:  IF DI[25:ON ]=ON AND DO[32:OFF]=ON,JMP LBL[24] ;
 126:  ;
 127:  ! ---------------------------- ;
 128:  LBL[24:POUNCE_POS] ;
 129:  J PR[9] 50% FINE ;
 130:  DO[31:OFF]=OFF ;
 131:  DO[32:OFF]=ON ;
 132:  ;
 133:  IF R[12]=1,JMP LBL[30] ;
 134:  IF R[12]=0,JMP LBL[40] ;
 135:  ;
 136:  LBL[30:OUTFEED_DROP] ;
 137:  CALL GN_OUTFEED_999 ;
 138:  UFRAME_NUM=0 ;
 139:  JMP LBL[40] ;
 140:  ;
 141:  ! ---------------------------- ;
 142:  LBL[40] ;
 143:  J PR[1] 50% CNT100 ;
 144:  ! WAIT FOR MAZAK DOOR CLOSED ;
 145:  WAIT DI[25:ON ]=ON AND DI[24:OFF]=OFF ;
 146:  DO[31:OFF]=OFF ;
 147:  DO[32:OFF]=OFF ;
 148:  IF R[30]>=400,JMP LBL[41] ;
 149:  IF R[10]<>3,JMP LBL[41] ;
 150:  IF DI[18:ON ]=OFF,JMP LBL[40] ;
 151:  IF R[10]=3,JMP LBL[1] ;
 152:  ;
 153:  ! ---------------------------- ;
 154:  LBL[41] ;
 155:  ! HANDLE STOP REQUEST ;
 156:  R[10]=0 ;
 157:  DO[30:OFF]=OFF ;
 158:  DO[31:OFF]=OFF ;
 159:  DO[32:OFF]=OFF ;
 160:  JMP LBL[1] ;
 161:  ;
 162:  ! ---------------------------- ;
 163:  LBL[90] ;
 164:  ! RETRY MAZAK DOOR OPEN ;
 165:  DO[32:OFF]=OFF ;
 166:  DO[31:OFF]=PULSE,10.0sec ;
 167:  IF DI[24:OFF]=OFF,JMP LBL[90] ;
 168:  JMP LBL[10] ;
 169:  ;
 170:  LBL[9999:END] ;
 171:  END ;
/POS
/END
