/PROG  GN_ESB_MAIN_F9
/ATTR
OWNER         = MNEDITOR;
COMMENT       = "ESB MAIN PROGRAM";
PROG_SIZE     = 3071;
CREATE        = DATE 14-09-2026 TIME 15:00:00;
MODIFIED      = DATE 14-09-2026 TIME 15:00:00;
FILE_NAME     = GN_ESB_MAIN_F9;
VERSION       = 0;
LINE_COUNT    = 170;
MEMORY_SIZE   = 3700;
PROTECT       = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  ! INITIALIZE I/O AND REGISTERS ;
   2:  DO[27:ON ]=ON ;
   3:  DO[30:OFF]=OFF ;
   4:  DO[31:OFF]=OFF ;
   5:  R[8]=0 ;
   6:  R[10]=0 ;
   7:  RO[1:OFF]=OFF ;
   8:  DO[31:OFF]=OFF ;
   9:  DO[32:OFF]=OFF ;
  10:  DO[9:ON ]=ON ;
  11:  ! ---------------------------- ;
  12:  ! INITIALIZE ESB REGISTERS ;
  13:  ! ---------------------------- ;
  14:  R[702:INF_PICK_OFFSET]=10 ;
  15:  R[701:INF_Hgt_OFFSET]=2 ;
  16:  ! GRAB MODE: 0=AUTO, 1=MANUAL ;
  17:  R[700:GRAB_MODE_SELECT]=0 ;
  18:  CALL GN_SET_RG_F9 ;
  19:  CALL GN_ESB_ASK_F9 ;
  20:  ! ---------------------------- ;
  21:  ! INITIALIZED STATE ;
  22:  ! ---------------------------- ;
  23:  LBL[1:INITIALIZED] ;
  24:  ! SET USER FRAME AND TOOL ;
  25:  UFRAME_NUM=0 ;
  26:  UTOOL_NUM=1 ;
  27:  ! MOVE ROBOT TO HOME POSITION ;
  28:  J PR[1:HOME.U0] 50% FINE ;
  29:  MESSAGE[Robot is at home position.] ;
  30:  WAIT 2.00(sec) ;
  31:  ! CLEAR TEACH PENDANT SCREEN ;
  32:  CALL GN_CLS_SC_F9 ;
  33:  ! DISPLAY STARTUP MESSAGES ;
  34:  MESSAGE[GN CORP - FRONTIER 09] ;
  35:  MESSAGE[MAIN PROGRAM STARTING.] ;
  36:  WAIT 3.00(sec) ;
  37:  ;
  38:  ! ---------------------------- ;
  39:  LBL[2:CHECK_RUN] ;
  40:  IF R[20]>=400,JMP LBL[1] ;
  41:  IF R[10]=1 OR R[10]=2,JMP LBL[41] ;
  42:  ;
  43:  ! CHECK MAZAK RUN CONDITIONS ;
  44:  IF DI[22:ON ]=OFF OR DI[19:ON ]=OFF,JMP LBL[1] ;
  45:  ! ---------------------------- ;
  46:  LBL[5:PRE_INFEED] ;
  47:  WAIT DI[1:OFF]=ON ;
  48:  DO[7:OFF]=ON ;
  49:  WAIT .50(sec) ;
  50:  WAIT DI[1:OFF]=OFF ;
  51:  DO[7:OFF]=OFF ;
  52:  DO[2:OFF]=OFF ;
  53:  DO[1:OFF]=ON ;
  54:  WAIT .50(sec) ;
  55:  ;
  56:  ! CHECK BAR FEED MODE ;
  57:  IF (R[3]=1) THEN ;
  58:    JMP LBL[10] ;
  59:  ELSE ;
  60:    CALL GN_INFEED_999 ;
  61:  ENDIF ;
  62:  ;
  63:  IF DI[14:OFF]=ON AND DI[10:OFF]=OFF,JMP LBL[1] ;
  64:  J PR[10] 100% CNT50 ;
  65:  ! ---------------------------- ;
  66:  WAIT DI[18:ON ]=OFF ;
  67:  IF R[10]=3 AND DI[18:ON ]=OFF AND DI[22:ON ]=ON AND DI[19:ON ]=ON AND DI[25:ON ]=ON,JMP LBL[10] ;
  68:  ;
  69:  LBL[10: CHECK_DOOR] ;
  70:  ! OPEN MAZAK DOOR ;
  71:  IF DI[24:OFF]=ON,JMP LBL[20] ;
  72:  DO[32:OFF]=OFF ;
  73:  DO[31:OFF]=ON ;
  74:  WAIT DI[24:OFF]=ON ;
  75:  DO[31:OFF]=OFF ;
  76:  IF DI[24:OFF]=OFF,JMP LBL[90] ;
  77:  ;
  78:  ! CHECK BAR FEED MODE ;
  79:  IF (R[3]=1) THEN ;
  80:    JMP LBL[20] ;
  81:  ELSE ;
  82:    JMP LBL[11] ;
  83:  ENDIF ;
  84:  ;
  85:  ! ---------------------------- ;
  86:  ! CHECK FOR WORKPIECE IN CHUCK ;
  87:  ;
  88:  LBL[11: CHECK_WORKPIECE] ;
  89:  DO[2:OFF]=OFF ;
  90:  DO[1:OFF]=ON ;
  91:  IF (DI[11:OFF]=ON AND DI[14:OFF]=ON) THEN ;
  92:    JMP LBL[9999] ;
  93:  ENDIF ;
  94:  ! ---------------------------- ;
  95:  ;
  96:  LBL[20:MOVE_TO_MZ] ;
  97:  UFRAME_NUM=0 ;
  98:  J PR[10] 100% CNT50 ;
  99:  J PR[11] 100% FINE ;
 100:  ;
 101:  ! CHECK BAR FEED MODE ;
 102:  IF (R[3]=1) THEN ;
 103:    JMP LBL[22] ;
 104:  ELSE ;
 105:    JMP LBL[21] ;
 106:  ENDIF ;
 107:  ;
 108:  ! ---------------------------- ;
 109:  LBL[21:LOAD_MZ] ;
 110:  UFRAME_NUM=3 ;
 111:  CALL GN_LOAD_991 ;
 112:  ;
 113:  ! ---------------------------- ;
 114:  LBL[22:UNLOAD_MZ] ;
 115:  CALL GN_UNLOAD_999 ;
 116:  ;
 117:  ! MOVE TO PRE-MAZAK POSITION ;
 118:  UFRAME_NUM=0 ;
 119:  J PR[21] 75% FINE ;
 120:  IF R[20]>300,JMP LBL[24] ;
 121:  R[8]=1 ;
 122:  DO[31:OFF]=OFF ;
 123:  DO[32:OFF]=PULSE,10.0sec ;
 124:  IF DI[25:ON ]=ON AND DO[32:OFF]=ON,JMP LBL[24] ;
 125:  ;
 126:  ! ---------------------------- ;
 127:  LBL[24:POUNCE_POS] ;
 128:  J PR[9] 50% FINE ;
 129:  DO[31:OFF]=OFF ;
 130:  DO[32:OFF]=ON ;
 131:  ;
 132:  IF R[12]=1,JMP LBL[30] ;
 133:  IF R[12]=0,JMP LBL[40] ;
 134:  ;
 135:  LBL[30:OUTFEED_DROP] ;
 136:  CALL GN_OUTFEED_999 ;
 137:  UFRAME_NUM=0 ;
 138:  JMP LBL[40] ;
 139:  ;
 140:  ! ---------------------------- ;
 141:  LBL[40] ;
 142:  J PR[1] 50% CNT100 ;
 143:  ! WAIT FOR MAZAK DOOR CLOSED ;
 144:  WAIT DI[25:ON ]=ON AND DI[24:OFF]=OFF ;
 145:  DO[31:OFF]=OFF ;
 146:  DO[32:OFF]=OFF ;
 147:  IF R[30]>=400,JMP LBL[41] ;
 148:  IF R[10]<>3,JMP LBL[41] ;
 149:  IF DI[18:ON ]=OFF,JMP LBL[40] ;
 150:  IF R[10]=3,JMP LBL[1] ;
 151:  ;
 152:  ! ---------------------------- ;
 153:  LBL[41] ;
 154:  ! HANDLE STOP REQUEST ;
 155:  R[10]=0 ;
 156:  DO[30:OFF]=OFF ;
 157:  DO[31:OFF]=OFF ;
 158:  DO[32:OFF]=OFF ;
 159:  JMP LBL[1] ;
 160:  ;
 161:  ! ---------------------------- ;
 162:  LBL[90] ;
 163:  ! RETRY MAZAK DOOR OPEN ;
 164:  DO[32:OFF]=OFF ;
 165:  DO[31:OFF]=PULSE,10.0sec ;
 166:  IF DI[24:OFF]=OFF,JMP LBL[90] ;
 167:  JMP LBL[10] ;
 168:  ;
 169:  LBL[9999:END] ;
 170:  END ;
/POS
/END
