PROGRAM GN_SET_ST_F9
%COMMENT = 'Load & Unload Offset Setup'
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%INCLUDE KLEVKEYS

VAR
  otf_offset   : INTEGER
  pick_offset  : INTEGER
  inf_offset   : INTEGER
  load_mode    : INTEGER
  raw_left     : INTEGER
  right_ref_w  : INTEGER
  finish_right : INTEGER
  cls_prog_idx : INTEGER
  save_ok      : BOOLEAN

---------------------------------------------------------
-- Update Register Value and Comment
---------------------------------------------------------
ROUTINE update_reg(reg_idx : INTEGER;
                   reg_val : INTEGER;
                   reg_name : STRING)
VAR
  status : INTEGER
BEGIN
  SET_REG_CMT(reg_idx, reg_name, status);

  IF status <> 0 THEN
    save_ok = FALSE;
    WRITE('Comment error: R[', reg_idx, ']', CR);
    WRITE('Status = ', status, CR);
    RETURN;
  ENDIF

  SET_INT_REG(reg_idx, reg_val, status);

  IF status <> 0 THEN
    save_ok = FALSE;
    WRITE('Value error: R[', reg_idx, ']', CR);
    WRITE('Status = ', status, CR);
  ENDIF
END update_reg

---------------------------------------------------------
-- Main Program
---------------------------------------------------------
BEGIN
  save_ok = TRUE;

  CALL_PROG('GN_CLS_SC_F9', cls_prog_idx);
  FORCE_SPMENU(TP_PANEL, SPI_TPUSER, 1);

  WRITE('============================', CR);
  WRITE('     LOAD / OFFSET SETUP    ', CR);
  WRITE('============================', CR);

  WRITE('Enter OUTFEED HEIGHT', CR);
  WRITE('OFFSET [mm]:', CR);
  READ(otf_offset);

  WRITE('Enter INFEED PICK', CR);
  WRITE('OFFSET [mm]:', CR);
  READ(pick_offset);

  WRITE('Enter INFEED HEIGHT', CR);
  WRITE('OFFSET [mm]:', CR);
  READ(inf_offset);

  REPEAT
    WRITE('Enter LOADING MODE:', CR);
    WRITE('0 = AUTO, 1 = MANUAL', CR);
    READ(load_mode);

    IF (load_mode <> 0) AND (load_mode <> 1) THEN
      WRITE('Invalid mode. Enter 0 or 1.', CR);
    ENDIF
  UNTIL (load_mode = 0) OR (load_mode = 1);

  WRITE('Enter distance from raw part', CR);
  WRITE('to LEFT CNC spindle [mm]:', CR);
  READ(raw_left);

  WRITE('Enter distance from RIGHT', CR);
  WRITE('spindle to reference W [mm]:', CR);
  READ(right_ref_w);

  WRITE('Enter distance from finished', CR);
  WRITE('part to RIGHT spindle [mm]:', CR);
  READ(finish_right);

  -------------------------------------------------------
  -- Save Values and Register Comments
  -------------------------------------------------------
  update_reg(803, otf_offset,   'OTF_Hgt_OFFSET');
  update_reg(802, pick_offset,  'INF_PICK_OFFSET');
  update_reg(801, inf_offset,   'INF_Hgt_OFFSET');
  update_reg(800, load_mode,    'Load_MODE_SELECT');
  update_reg(804, raw_left,     'RAW_LEFT_DIST');
  update_reg(805, right_ref_w,  'RIGHT_REF_W_DIST');
  update_reg(806, finish_right, 'FIN_RIGHT_DIST');

  -------------------------------------------------------
  -- Display Result
  -------------------------------------------------------
  IF save_ok THEN
    CALL_PROG('GN_CLS_SC_F9', cls_prog_idx);

    WRITE('Data Saved Successfully!', CR);
    WRITE('R[803] OTF Hgt = ', otf_offset, ' [mm]', CR);
    WRITE('R[802] INF Pick = ', pick_offset, ' [mm]', CR);
    WRITE('R[801] INF Hgt = ', inf_offset, ' [mm]', CR);
    WRITE('R[800] Load Mode = ', load_mode, CR);
    WRITE('R[804] Raw to Left = ', raw_left, ' [mm]', CR);
    WRITE('R[805] Right to W = ', right_ref_w, ' [mm]', CR);
    WRITE('R[806] Finish to Right = ', finish_right, ' [mm]', CR);

    IF load_mode = 0 THEN
      WRITE('Loading Mode: AUTO', CR);
    ELSE
      WRITE('Loading Mode: MANUAL', CR);
    ENDIF
  ELSE
    WRITE('Save incomplete.', CR);
    WRITE('Some registers may be updated.', CR);
    WRITE('Check errors shown above.', CR);
  ENDIF

  DELAY 3000;
END GN_SET_ST_F9
