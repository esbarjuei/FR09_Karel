/PROG  JOB_VAR_OD_GRIP
/ATTR
OWNER        = MNEDITOR;
COMMENT      = "";
PROG_SIZE    = 0;
CREATE       = DATE 19-07-31  TIME 17:01:20;
MODIFIED     = DATE 26-06-08  TIME 14:37:38;
FILE_NAME    = JOB_VARI;
VERSION      = 0;
LINE_COUNT   = 123;
MEMORY_SIZE  = 0;
PROTECT      = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  !R[70] is the item number ;
   2:  !R[71] if using previous data ;
   3:  R[196]=AR[1] ;
   4:  R[197]=AR[2] ;
   5:  !------------------------- ;
   6:  !Item Select = 111199990 ;
   7:  SELECT R[196]=9990,JMP LBL[9990] ;
   8:       ELSE,JMP LBL[9999] ;
   9:  LBL[9990] ;
  10:  !--------------------------- ;
  11:  !KAREL PROGRAM ;
  12:  !Item 1111199990 ;
  13:  !Last Modified: 2026-Sep-17 ;
  14:  !Modified by: Erfan ;
  15:  !--------------------------- ;
  16:  IF (R[70]=9990) THEN ;
  17:    !Define Parameters for INF/OTF ;
  18:    CALL JOB_VAR_SETUP(900) ;
  19:    CALL GN_CLS_SC_F9 ;
  20:    MESSAGE[OD GRIPPING STARTS] ;
  21:    WAIT 3.00(sec) ;
  22:    !--------------------------- ;
  23:    !Define Parameters for Job ;
  24:    !R[85] "INF_JAW_OFFSET"(Hgt) ;
  25:    R[85:INF_JAW_OFFSET]=0 ;
  26:    !R[86] "INF_PICK_OFFSET" 50mm/sec ;
  27:    R[86:INF_PICK_OFFSET]=R[802] ;
  28:    !R[87] "MAIN_LOAD_OFFSET" (PRELOAD) ;
  29:    R[87]=0 ;
  30:    !R[100] "GRIPPER_ID" 3 values ;
  31:    !If =100, ID Grippers Installed ;
  32:    !If =200, OD Grippers Installed ;
  33:    R[100:GRIPPER_ID]=200 ;
  34:    !--------------------------- ;
  35:    !If using previous setup data ;
  36:    IF (R[71]=9990) THEN ;
  37:      !--------------------------- ;
  38:      !1st: Height of Raw piece ;
  39:      R[190:Hgt_Raw_piece]=R[410] ;
  40:      !2nd: Height of Finish piece ;
  41:      R[191:Hgt_Fin_piece]=R[414] ;
  42:      !3rd: Infeed Height Offset ;
  43:      R[192:Infeed Height Offset]=R[801] + R[410] + (-325) + R[417] ;
  44:      !4th: Outfeed Height Offset ;
  45:      R[193:Outfeed_Height_Offset]=R[803] + R[414] + (-400) + R[417] ;
  46:      !--------------------------- ;
  47:      CALL CREATE_REG(R[190],R[191],R[192],R[193]) ;
  48:    ENDIF ;
  49:    ! ===================================== ;
  50:    ! LOAD & UNLOAD MODE: MANUAL ;
  51:    ! ===================================== ;
  52:    IF (R[800:Load_MODE_SELECT]=1) THEN ;
  53:      CALL GN_CLS_SC_F9 ;
  54:      MESSAGE[LOAD & UNLOAD MODE is MANUAL.] ;
  55:      WAIT 0.0(sec) ;
  56:      !If new loading or offloading pos ;
  57:      !SET R[104] "IMPORT_LOADPOS" ;
  58:      !SET R[104]=1000, Otherwise NO ;
  59:      R[104]=1000 ;
  60:      IF (R[104]=1000) THEN ;
  61:        !R[260]=43, Preload Pos1 ;
  62:        !R[270]=44, Preload PosFinal ;
  63:        !R[300]=53, Offload PosFinal ;
  64:        !PR[43] Pre-Loading Pos1 ;
  65:        CALL CREATE_PR(43 , R[850:PRLOAD_X] , R[851:PRLOAD_Y] , R[852:PRLOAD_Z] , R[853:PRLOAD_A] ,R[854:PRLOAD_B] , R[855:PRLOAD_C])  ;
  66:        !PR[44] Final Loading Position ;
  67:        CALL CREATE_PR(44 , R[857:LOAD_X] , R[858:LOAD_Y] , R[859:LOAD_Z] , R[860:LOAD_A] , R[861:LOAD_B] , R[862:LOAD_C]) ;
  68:        !PR[53] Pre-Unloading Position ;
  69:        CALL CREATE_PR(53 , R[864:PRUNLOAD_X] , R[865:PRUNLOAD_Y] , R[866:PRUNLOAD_Z] , R[867:PRUNLOAD_A] , R[868:PRUNLOAD_B] , R[869:PRUNLOAD_C]) ;
  70:        !PR[54] Final Unloading Position ;
  71:        CALL CREATE_PR(54 , R[871:UNLOAD_X] , R[872:UNLOAD_Y] , R[873:UNLOAD_Z] , R[874:UNLOAD_A] , R[875:UNLOAD_B] , R[876:UNLOAD_C]) ;
  72:        !PR[56] assitant Unloading preses ;
  73:        CALL CREATE_PR(56,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  74:        !PR[57] assitant Unloading preses ;
  75:        CALL CREATE_PR(57,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  76:        !PR[58] assitant Unloading preses ;
  77:        CALL CREATE_PR(58,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  78:      ENDIF ;
  79:    ENDIF ;
  80:    ! ===================================== ;
  81:    ! LOAD & UNLOAD MODE: AUTOMATIC ;
  82:    ! ===================================== ;
  83:    IF (R[800:Load_MODE_SELECT]=0) THEN ;
  84:      CALL GN_CLS_SC_F9 ;
  85:      MESSAGE[LOAD & UNLOAD MODE is AUTOMATIC.] ;
  86:      WAIT 0.25(sec) ;
  87:      !New loading or offloading pos ;
  88:      !R[104] IMPORT_LOADPOS ;
  89:      !1000: Import positions ;
  90:      R[104]=1000 ;
  91:      IF (R[104]=1000) THEN ;
  92:        !R[260]=43, Preload Pos1 ;
  93:        !R[270]=44, Preload PosFinal ;
  94:        !R[300]=53, Offload PosFinal ;
  95:        !PR[43] Pre-Loading Pos1 ;
  96:        CALL CREATE_PR(43,165.86,(-61.611),145.429,150.192,89.173,148.558) ;
  97:        !PR[44] Final Loading Position ;
  98:        CALL CREATE_PR(44,167.886,(-62.489),311.377,150.836,89.177,149.22) ;
  99:        !PR[53] Pre-Unloading Position ;
 100:        CALL CREATE_PR(53,(-130.481),93.166,172.006,168.789,(-88.281),(-170.136)) ;
 101:        !PR[54] Final Unloading Position ;
 102:        CALL CREATE_PR(54,(-128.735),93.392,117.767,169.08,(-88.268),(-170.429)) ;
 103:        !PR[56] Assist Unloading Pos ;
 104:        CALL CREATE_PR(56,(-133.84),95.467,273.686,(-177.134),(-88.249),175.184) ;
 105:        !PR[57] Assist Unloading Pos ;
 106:        CALL CREATE_PR(57,(-135.964),108.085,344.284,(-177.144),(-88.245),175.194) ;
 107:        !PR[58] Assist Unloading Pos ;
 108:        CALL CREATE_PR(58,296.854,360.959,378.47,(-91.75),(-.28),88.063) ;
 109:      ENDIF ;
 110:    ENDIF ;
 111:    !---------------------------- ;
 112:    !SR[2] = "JOB_VAR_OD_GRIP" ;
 113:    !JOB_VAR_COMMON(R[103])'s value ;
 114:    !Pallet data from Karel program ;
 115:    !---------------------------- ;
 116:    R[103:JOB_PROFILE]=920 ;
 117:    CALL JOB_VAR_COMMON(R[103]) ;
 118:  ENDIF ;
 119:  JMP LBL[9999] ;
 120:  !--------------------------- ;
 121:  LBL[9999] ;
 122:  !Program Ends, no further logic ;
 123:  END ;
/POS
/END
