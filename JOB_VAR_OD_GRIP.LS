/PROG  JOB_VAR_OD_GRIP
/ATTR
OWNER       = MNEDITOR;
COMMENT     = "";
PROG_SIZE   = 0;
CREATE      = DATE 19-07-31  TIME 17:01:20;
MODIFIED    = DATE 26-06-08  TIME 14:37:38;
FILE_NAME   = JOB_VARI;
VERSION     = 0;
LINE_COUNT  = 150;
MEMORY_SIZE = 0;
PROTECT     = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  !R[70] is the item number ;
   2:  !R[71] if using previous data ;
   3:  R[196]=AR[1] ;
   4:  R[197]=AR[2] ;
   5:  !------------------------- ;
   6:  !Item Select = 111199990 ;
   7:  SELECT R[196]=9990,JMP LBL[9990] ;
   8:         ELSE,JMP LBL[9999] ;
   9:  LBL[9990] ;
  10:  !--------------------------- ;
  11:  !KAREL PROGRAM ;
  12:  !Item 1111199990 ;
  13:  !Last Modified: 2026-Sep-17 ;
  14:  !Modified by: Erfan ;
  15:  !--------------------------- ;
  16:  IF (R[70]=9990) THEN ;
  17:  !Define Parameters for INF/OTF ;
  18:  !R[105]=AR[1]=100, 2By3 Sheet ;
  19:  !R[105]=AR[1]=200, 3By4 Sheet ;
  20:  !R[105]=AR[1]=300, 5By7 Sheet ;
  21:  CALL JOB_VAR_SETUP(400) ;
  22:  CALL GN_CLS_SC_F9 ;
  23:  MESSAGE[OD GRIPPING STARTS] ;
  24:  WAIT 3.00(sec) ;
  25:  !--------------------------- ;
  26:  !Define Parameters for Job ;
  27:  !R[85] "INF_JAW_OFFSET"(Hgt) ;
  28:  R[85]=0 ;
  29:  !R[86] "INF_PICK_OFFSET" 50mm/sec ;
  30:  R[86]=0 ;
  31:  !R[87] "MAIN_LOAD_OFFSET" (PRELOA ;
  32:  R[87]=100 ;
  33:  !R[100] "GRIPPER_ID" 3 values ;
  34:  !If =100, ID Grippers Installed ;
  35:  !If =200, OD Grippers Installed ;
  36:  !If =300, OD 45 Degree Grippers ;
  37:  R[100]=200 ;
  38:  !--------------------------- ;
  39:  !If using previous setup data ;
  40:  IF (R[71]=9990) THEN ;
  41:  !--------------------------- ;
  42:  !1st: Height of Raw piece ;
  43:  R[190]=0 ;
  44:  !2nd: Height of Finish piece ;
  45:  R[191]=0 ;
  46:  !3rd: Infeed Height Offset ;
  47:  R[192]=0 ;
  48:  !4th: Outfeed Height Offset ;
  49:  R[193]=(-46.5) ;
  50:  !--------------------------- ;
  51:  CALL CREATE_REG(R[190],R[191],R[192],R[193]) ;
  52:  ENDIF ;
  53:  !If new loading or offloading pos ;
  54:  !SET R[104] "IMPORT_LOADPOS" ;
  55:  !SET R[104]=1000, Otherwise NO ;
  56:  R[104]=1000 ;
  57:  IF (R[104]=1000) THEN ;
  58:  !R[260]=43, Preload Pos1 ;
  59:  !R[270]=44, Preload PosFinal ;
  60:  !R[300]=53, Offload PosFinal ;
  61:  !PR[43] Pre-Loading Pos1 ;
  62:  CALL CREATE_PR(43,168.835,(-63.534),347.629,158.268,89.347,156.235) ;
  63:  !PR[44] Final Loading Position ;
  64:  CALL CREATE_PR(44,168.927,(-63.781),356.006,158.173,89.348,156.13) ;
  65:  !PR[53] Pre Unloading Position ;
  66:  CALL CREATE_PR(53,(-129.883),93.702,179.02,170.509,(-88.382),(-168.991)) ;
  67:  !PR[54] Final Unloading Position ;
  68:  CALL CREATE_PR(54,(-128.536),94.044,130.257,170.547,(-88.382),(-169.034)) ;
  69:  !PR[56] assitant Unloading preses ;
  70:  CALL CREATE_PR(56,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  71:  !PR[57] assitant Unloading preses ;
  72:  CALL CREATE_PR(57,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  73:  !PR[58] assitant Unloading preses ;
  74:  CALL CREATE_PR(58,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  75:  ENDIF ;
  76:  !---------------------------- ;
  77:  !SR[2] = "JOB_VAR_OD_GRIP" ;
  78:  !JOB_VAR_COMMON(R[103])'s value ;
  79:  !---------------------------- ;
  80:  !2By3 SR[2] INF, Max 18(Straight) ;
  81:  !R[103]=200 ;
  82:  !2By3 INF 45 Degree Diagonal Shif ;
  83:  !R[103]=210 ;
  84:  !---------------------------- ;
  85:  !3By4 SR[2] INF, Max 36(Straight) ;
  86:  !R[103]=250 ;
  87:  !3By4 INF 45 Degree Diagonal Shif ;
  88:  !R[103]=260 ;
  89:  !---------------------------- ;
  90:  !R[103] "JOB_PROFILE" Selection ;
  91:  R[103]=270 ;
  92:  CALL JOB_VAR_COMMON(R[103]) ;
  93:  ENDIF ;
  94:  JMP LBL[9999] ;
  95:  !Job 102649814 Logic Ends ;
  96:  !--------------------------- ;
  97:  LBL[9999] ;
  98:  !Program Ends, no further logic ;
  99:  END ;
/POS
/END
