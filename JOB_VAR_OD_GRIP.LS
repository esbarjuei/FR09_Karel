/PROG  JOB_VAR_OD_GRIP
/ATTR
OWNER        = MNEDITOR;
COMMENT      = "";
PROG_SIZE    = 0;
CREATE       = DATE 19-07-31  TIME 17:01:20;
MODIFIED     = DATE 26-06-08  TIME 14:37:38;
FILE_NAME    = JOB_VARI;
VERSION      = 0;
LINE_COUNT   = 94;
MEMORY_SIZE  = 0;
PROTECT      = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  !R[70] is the item number ;
   2:  !R[71] if using previous data ;
   3:  R[196]=AR[1] ;
   4:  R[197]=AR[2] ;
   5:  !------------------------- ;
   6:  !Item Select = 111199990 ;
   7:  SELECT R[196]=9990,JMP LBL[9990] ;
   8:         ELSE,JMP LBL[9999] ;
   9:  LBL[9990] ;
  10:  !--------------------------- ;
  11:  !KAREL PROGRAM ;
  12:  !Item 1111199990 ;
  13:  !Last Modified: 2026-Sep-17 ;
  14:  !Modified by: Erfan ;
  15:  !--------------------------- ;
  16:  IF (R[70]=9990) THEN ;
  17:    !Define Parameters for INF/OTF ;
  18:    CALL JOB_VAR_SETUP(900) ;
  19:    CALL GN_CLS_SC_F9 ;
  20:    MESSAGE[OD GRIPPING STARTS] ;
  21:    WAIT 3.00(sec) ;
  22:    !--------------------------- ;
  23:    !Define Parameters for Job ;
  24:    !R[85] "INF_JAW_OFFSET"(Hgt) ;
  25:    R[85:INF_JAW_OFFSET]=R[417] ;
  26:    !R[86] "INF_PICK_OFFSET" 50mm/sec ;
  27:    R[86:INF_PICK_OFFSET]=R[802] ;
  28:    !R[87] "MAIN_LOAD_OFFSET" (PRELOA ;
  29:    R[87]=100 ;
  30:    !R[100] "GRIPPER_ID" 3 values ;
  31:    !If =100, ID Grippers Installed ;
  32:    !If =200, OD Grippers Installed ;
  33:    R[100:GRIPPER_ID]=200 ;
  34:    !--------------------------- ;
  35:    !If using previous setup data ;
  36:    IF (R[71]=9990) THEN ;
  37:      !--------------------------- ;
  38:      !1st: Height of Raw piece ;
  39:      R[190:Hgt_Raw_piece]=R[410] + (-325) ;
  40:      !2nd: Height of Finish piece ;
  41:      R[191]=0 ;
  42:      !3rd: Infeed Height Offset ;
  43:      R[192:Infeed Height Offset]=R[801] ;
  44:      !4th: Outfeed Height Offset ;
  45:      R[193]=(-46.5) ;
  46:      !--------------------------- ;
  47:      CALL CREATE_REG(R[190],R[191],R[192],R[193]) ;
  48:    ENDIF ;
  49:    !If new loading or offloading pos ;
  50:    !SET R[104] "IMPORT_LOADPOS" ;
  51:    !SET R[104]=1000, Otherwise NO ;
  52:    R[104]=1000 ;
  53:    IF (R[104]=1000) THEN ;
  54:      !R[260]=43, Preload Pos1 ;
  55:      !R[270]=44, Preload PosFinal ;
  56:      !R[300]=53, Offload PosFinal ;
  57:      !PR[43] Pre-Loading Pos1 ;
  58:      CALL CREATE_PR(43,168.835,(-63.534),347.629,158.268,89.347,156.235) ;
  59:      !PR[44] Final Loading Position ;
  60:      CALL CREATE_PR(44,168.927,(-63.781),356.006,158.173,89.348,156.13) ;
  61:      !PR[53] Pre Unloading Position ;
  62:      CALL CREATE_PR(53,(-129.883),93.702,179.02,170.509,(-88.382),(-168.991)) ;
  63:      !PR[54] Final Unloading Position ;
  64:      CALL CREATE_PR(54,(-128.536),94.044,130.257,170.547,(-88.382),(-169.034)) ;
  65:      !PR[56] assitant Unloading preses ;
  66:      CALL CREATE_PR(56,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  67:      !PR[57] assitant Unloading preses ;
  68:      CALL CREATE_PR(57,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  69:      !PR[58] assitant Unloading preses ;
  70:      CALL CREATE_PR(58,(-131.536),105.713,233.177,173.746,(-88.233),(-175.647)) ;
  71:    ENDIF ;
  72:    !---------------------------- ;
  73:    !SR[2] = "JOB_VAR_OD_GRIP" ;
  74:    !JOB_VAR_COMMON(R[103])'s value ;
  75:    !---------------------------- ;
  76:    !2By3 SR[2] INF, Max 18(Straight) ;
  77:    !R[103]=200 ;
  78:    !2By3 INF 45 Degree Diagonal Shif ;
  79:    !R[103]=210 ;
  80:    !---------------------------- ;
  81:    !3By4 SR[2] INF, Max 36(Straight) ;
  82:    !R[103]=250 ;
  83:    !3By4 INF 45 Degree Diagonal Shif ;
  84:    !R[103]=260 ;
  85:    !---------------------------- ;
  86:    !R[103] "JOB_PROFILE" Selection ;
  87:    R[103]=270 ;
  88:    CALL JOB_VAR_COMMON(R[103]) ;
  89:  ENDIF ;
  90:  JMP LBL[9999] ;
  91:  !--------------------------- ;
  92:  LBL[9999] ;
  93:  !Program Ends, no further logic ;
  94:  END ;
/POS
/END
