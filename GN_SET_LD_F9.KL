PROGRAM GN_SET_LD_F9
%COMMENT = 'Load Offset Setup'
%NOLOCKGROUP
%NOPAUSE = ERROR + COMMAND + TPENABLE
%INCLUDE KLEVKEYS

VAR
  otf_offset : INTEGER
  pick_offset : INTEGER
  inf_offset : INTEGER
  load_mode  : INTEGER
  save_ok    : BOOLEAN

---------------------------------------------------------
-- Update Register Value and Comment
---------------------------------------------------------
ROUTINE update_reg(reg_idx : INTEGER;
                   reg_val : INTEGER;
                   reg_name : STRING)
VAR
  status : INTEGER
BEGIN
  SET_REG_CMT(reg_idx, reg_name, status)

  IF status <> 0 THEN
    save_ok = FALSE
    WRITE('Comment error: R[', reg_idx, ']', CR)
    WRITE('Status = ', status, CR)
    RETURN
  ENDIF

  SET_INT_REG(reg_idx, reg_val, status)

  IF status <> 0 THEN
    save_ok = FALSE
    WRITE('Value error: R[', reg_idx, ']', CR)
    WRITE('Status = ', status, CR)
  ENDIF
END update_reg

---------------------------------------------------------
-- Main Program
---------------------------------------------------------
BEGIN
  save_ok = TRUE

  WRITE(CHR(128), CHR(137))
  FORCE_SPMENU(TP_PANEL, SPI_TPUSER, 1)

  WRITE('============================', CR)
  WRITE('     LOAD / OFFSET SETUP    ', CR)
  WRITE('============================', CR)

  WRITE('Enter OUTFEED HEIGHT OFFSET:', CR)
  READ(otf_offset)

  WRITE('Enter INFEED PICK OFFSET:', CR)
  READ(pick_offset)

  WRITE('Enter INFEED HEIGHT OFFSET:', CR)
  READ(inf_offset)

  REPEAT
    WRITE('Enter LOADING MODE:', CR)
    WRITE('0 = AUTO, 1 = MANUAL', CR)
    READ(load_mode)

    IF (load_mode <> 0) AND (load_mode <> 1) THEN
      WRITE('Invalid mode. Enter 0 or 1.', CR)
    ENDIF
  UNTIL (load_mode = 0) OR (load_mode = 1)

  -------------------------------------------------------
  -- Save Values and Register Comments
  -------------------------------------------------------
  update_reg(803, otf_offset,  'OTF_Hgt_OFFSET')
  update_reg(802, pick_offset, 'INF_PICK_OFFSET')
  update_reg(801, inf_offset,  'INF_Hgt_OFFSET')
  update_reg(800, load_mode,   'Load_MODE_SELECT')

  -------------------------------------------------------
  -- Display Result
  -------------------------------------------------------
  IF save_ok THEN
    WRITE(CHR(128), CHR(137))
    WRITE('Data Saved Successfully!', CR)
    WRITE('R[803] OTF Hgt = ', otf_offset, CR)
    WRITE('R[802] INF Pick = ', pick_offset, CR)
    WRITE('R[801] INF Hgt = ', inf_offset, CR)
    WRITE('R[800] Load Mode = ', load_mode, CR)

    IF load_mode = 0 THEN
      WRITE('Loading Mode: AUTO', CR)
    ELSE
      WRITE('Loading Mode: MANUAL', CR)
    ENDIF
  ELSE
    WRITE('Save incomplete.', CR)
    WRITE('Some registers may be updated.', CR)
    WRITE('Check errors shown above.', CR)
  ENDIF

  DELAY 3000
END GN_SET_LD_F9