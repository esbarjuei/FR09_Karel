/PROG  JOB_VAR_ID_GRIP
/ATTR
OWNER        = MNEDITOR;
COMMENT      = "";
PROG_SIZE    = 0;
CREATE       = DATE 19-07-31  TIME 17:01:20;
MODIFIED     = DATE 26-07-17  TIME 17:40:38;
FILE_NAME    = JOB_VARI;
VERSION      = 0;
LINE_COUNT   = 123;
MEMORY_SIZE  = 0;
PROTECT      = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  !R[70] is the item number ;
   2:  !R[71] if using previous data ;
   3:  R[196]=AR[1] ;
   4:  R[197]=AR[2] ;
   5:  !------------------------- ;
   6:  !Item Select = 1111199990 ;
   7:  SELECT R[196]=9990,JMP LBL[9990] ;
   8:          ELSE,JMP LBL[9999] ;
   9:  LBL[9990] ;
  10:  !--------------------------- ;
  11:  !KAREL PROGRAM ;
  12:  !Item 1111199990 ;
  13:  !Last Modified: 2026-Sep-17 ;
  14:  !Modified by: Erfan ;
  15:  !--------------------------- ;
  16:  IF (R[70]=9990) THEN ;
  17:    !Define Parameters for INF/OTF ;
  18:    CALL JOB_VAR_SETUP(900) ;
  19:    CALL GN_CLS_SC_F9 ;
  20:    MESSAGE[ID GRIPPING STARTS] ;
  21:    WAIT 3.00(sec) ;
  22:    !--------------------------- ;
  23:    !Define Parameters for Job ;
  24:    R[1]=1 ;
  25:    R[2]=0 ;
  26:    R[4]=0 ;
  27:    R[67]=40 ;
  28:    !R[85] INF_JAW_OFFSET (Hgt) ;
  29:    R[85:INF_JAW_OFFSET]=0 ;
  30:    !R[86] INF_PICK_OFFSET ;
  31:    R[86:INF_PICK_OFFSET]=R[802] ;
  32:    !R[87] MAIN_LOAD_OFFSET ;
  33:    R[87]=0 ;
  34:    !R[100] GRIPPER_ID ;
  35:    !100: ID Grippers Installed ;
  36:    !200: OD Grippers Installed ;
  37:    R[100:GRIPPER_ID]=100 ;
  38:    !--------------------------- ;
  39:    !If using previous setup data ;
  40:    IF (R[71]=9990) THEN ;
  41:      !--------------------------- ;
  42:      !1st: Height of Raw piece ;
  43:      R[190:Hgt_Raw_piece]=R[410] ;
  44:      !2nd: Height of Finish piece ;
  45:      R[191:Hgt_Fin_piece]=R[414] ;
  46:      !3rd: Infeed Height Offset ;
  47:      R[192:Infeed Height Offset]=R[801]+R[410]+(-325)+R[417] ;
  48:      !4th: Outfeed Height Offset ;
  49:      R[193:Outfeed_Height_Offset]=R[803]+R[414]+(-400)+R[417] ;
  50:      !--------------------------- ;
  51:      CALL CREATE_REG(R[190],R[191],R[192],R[193]) ;
  52:    ENDIF ;
  53:    ! ===================================== ;
  54:    ! LOAD & UNLOAD MODE: MANUAL ;
  55:    ! ===================================== ;
  56:    IF (R[800:Load_MODE_SELECT]=1) THEN ;
  57:      CALL GN_CLS_SC_F9 ;
  58:      MESSAGE[LOAD & UNLOAD MODE is MANUAL.] ;
  59:      WAIT 0.0(sec) ;
  60:      !New loading or offloading pos ;
  61:      !R[104] IMPORT_LOADPOS ;
  62:      !1000: Import positions ;
  63:      R[104]=1000 ;
  64:      IF (R[104]=1000) THEN ;
  65:        !R[260]=43, Preload Pos1 ;
  66:        !R[270]=44, Preload PosFinal ;
  67:        !R[300]=53, Offload PosFinal ;
  68:        !PR[43] Pre-Loading Pos1 ;
  69:        CALL CREATE_PR(43 , R[850:PRLOAD_X] , R[851:PRLOAD_Y] , R[852:PRLOAD_Z] , R[853:PRLOAD_A] ,R[854:PRLOAD_B] , R[855:PRLOAD_C])  ;
  70:        !PR[44] Final Loading Position ;
  71:        CALL CREATE_PR(44 , R[857:LOAD_X] , R[858:LOAD_Y] , R[859:LOAD_Z] , R[860:LOAD_A] , R[861:LOAD_B] , R[862:LOAD_C]) ;
  72:        !PR[53] Pre-Unloading Position ;
  73:        CALL CREATE_PR(53 , R[864:PRUNLOAD_X] , R[865:PRUNLOAD_Y] , R[866:PRUNLOAD_Z] , R[867:PRUNLOAD_A] , R[868:PRUNLOAD_B] , R[869:PRUNLOAD_C]) ;
  74:        !PR[54] Final Unloading Position ;
  75:        CALL CREATE_PR(54 , R[871:UNLOAD_X] , R[872:UNLOAD_Y] , R[873:UNLOAD_Z] , R[874:UNLOAD_A] , R[875:UNLOAD_B] , R[876:UNLOAD_C]) ;
  76:        !PR[56] Assist Unloading Pos ;
  77:        CALL CREATE_PR(56,(-133.84),95.467,273.686,(-177.134),(-88.249),175.184) ;
  78:        !PR[57] Assist Unloading Pos ;
  79:        CALL CREATE_PR(57,(-135.964),108.085,344.284,(-177.144),(-88.245),175.194) ;
  80:        !PR[58] Assist Unloading Pos ;
  81:        CALL CREATE_PR(58,296.854,360.959,378.47,(-91.75),(-.28),88.063) ;
  82:      ENDIF ;
  83:    ENDIF ;
  84:    ! ===================================== ;
  85:    ! LOAD & UNLOAD MODE: AUTOMATIC ;
  86:    ! ===================================== ;
  87:    IF (R[800:Load_MODE_SELECT]=0) THEN ;
  88:      CALL GN_CLS_SC_F9 ;
  89:      MESSAGE[LOAD & UNLOAD MODE is AUTOMATIC.] ;
  90:      WAIT 0.25(sec) ;
  91:      !New loading or offloading pos ;
  92:      !R[104] IMPORT_LOADPOS ;
  93:      !1000: Import positions ;
  94:      R[104]=1000 ;
  95:      IF (R[104]=1000) THEN ;
  96:        !R[260]=43, Preload Pos1 ;
  97:        !R[270]=44, Preload PosFinal ;
  98:        !R[300]=53, Offload PosFinal ;
  99:        !PR[43] Pre-Loading Pos1 ;
 100:         CALL CREATE_PR(44,167.886,(-62.489),311.377,150.836,89.177,149.22) ;
 101:        !PR[44] Final Loading Position ;
 102:        CALL CREATE_PR(44,167.886,(-62.489),311.377,150.836,89.177,149.22) ;
 103:        !PR[53] Pre-Unloading Position ;
 104:        CALL CREATE_PR(53,(-130.481),93.166,172.006,168.789,(-88.281),(-170.136)) ;
 105:        !PR[54] Final Unloading Position ;
 106:        CALL CREATE_PR(54,(-128.735),93.392,117.767,169.08,(-88.268),(-170.429)) ;
 107:        !PR[56] Assist Unloading Pos ;
 108:        CALL CREATE_PR(56,(-133.84),95.467,273.686,(-177.134),(-88.249),175.184) ;
 109:        !PR[57] Assist Unloading Pos ;
 110:        CALL CREATE_PR(57,(-135.964),108.085,344.284,(-177.144),(-88.245),175.194) ;
 111:        !PR[58] Assist Unloading Pos ;
 112:        CALL CREATE_PR(58,296.854,360.959,378.47,(-91.75),(-.28),88.063) ;
 113:      ENDIF ;
 114:    ENDIF ;
 115:    !---------------------------- ;
 116:    !SR[1] = JOB_VAR_ID_GRIP ;
 117:    !JOB_VAR_COMMON uses R[103] ;
 118:    !Pallet data from Karel program ;
 119:    !---------------------------- ;
 120:    R[103:JOB_PROFILE]=910 ;
 121:    CALL JOB_VAR_COMMON(R[103]) ;
 122:  ENDIF ;
 123:  LBL[9999] ;
/POS
/END
