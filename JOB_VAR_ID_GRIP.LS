/PROG  JOB_VAR_ID_GRIP
/ATTR
OWNER       = MNEDITOR;
COMMENT     = "";
PROG_SIZE   = 0;
CREATE      = DATE 19-07-31  TIME 17:01:20;
MODIFIED    = DATE 26-07-17  TIME 17:40:38;
FILE_NAME   = JOB_VARI;
VERSION     = 0;
LINE_COUNT  = 97;
MEMORY_SIZE = 0;
PROTECT     = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF  = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  !R[70] is the item number ;
   2:  !R[71] if using previous data ;
   3:  R[196]=AR[1] ;
   4:  R[197]=AR[2] ;
   5:  !------------------------- ;
   6:  !Item Select = 1111199990 ;
   7:  SELECT R[196]=9990,JMP LBL[9990] ;
   8:         ELSE,JMP LBL[9999] ;
   9:  LBL[9990] ;
  10:  !--------------------------- ;
  11:  !KAREL PROGRAM ;
  12:  !Item 1111199990 ;
  13:  !Last Modified: 2026-Sep-17 ;
  14:  !Modified by: Erfan ;
  15:  !--------------------------- ;
  16:  IF (R[70]=9990) THEN ;
  17:  !Define Parameters for INF/OTF ;
  18:  !R[105]=AR[1]=100, 2By3 Sheet ;
  19:  !R[105]=AR[1]=200, 3By4 Sheet ;
  20:  CALL JOB_VAR_SETUP(100) ;
  21:  CALL GN_CLS_SC_F9 ;
  22:  MESSAGE[ID GRIPPING STARTS] ;
  23:  WAIT 3.00(sec) ;
  24:  !--------------------------- ;
  25:  !Define Parameters for Job ;
  26:  R[1]=1 ;
  27:  R[2]=0 ;
  28:  R[4]=0 ;
  29:  R[67]=40 ;
  30:  !R[85] "INF_JAW_OFFSET"(Hgt) ;
  31:  R[85]=0 ;
  32:  !R[86] "INF_PICK_OFFSET" 50mm/sec ;
  33:  R[86]=0 ;
  34:  !R[87] "MAIN_LOAD_OFFSET" (PRELOA ;
  35:  R[87]=0 ;
  36:  !R[100] "GRIPPER_ID" 3 values ;
  37:  !If =100, ID Grippers Installed ;
  38:  !If =200, OD Grippers Installed ;
  39:  !If =300, OD 45 Degree Grippers ;
  40:  R[100]=100 ;
  41:  !--------------------------- ;
  42:  !If using previous setup data ;
  43:  IF (R[71]=9990) THEN ;
  44:  !--------------------------- ;
  45:  !1st: Height of Raw piece ;
  46:  R[190]=0 ;
  47:  !2nd: Height of Finish piece ;
  48:  R[191]=0 ;
  49:  !3rd: Infeed Height Offset ;
  50:  R[192]=0 ;
  51:  !4th: Outfeed Height Offset ;
  52:  R[193]=(-235) ;
  53:  !--------------------------- ;
  54:  CALL CREATE_REG(R[190],R[191],R[192],R[193]) ;
  55:  ENDIF ;
  56:  !If new loading or offloading pos ;
  57:  !SET R[104] "IMPORT_LOADPOS" ;
  58:  !SET R[104]=1000, Otherwise NO ;
  59:  R[104]=1000 ;
  60:  IF (R[104]=1000) THEN ;
  61:  !R[260]=43, Preload Pos1 ;
  62:  !R[270]=44, Preload PosFinal ;
  63:  !R[300]=53, Offload PosFinal ;
  64:  !PR[43] Pre-Loading Pos1 ;
  65:  CALL CREATE_PR(43,165.86,(-61.611),145.429,150.192,89.173,148.558) ;
  66:  !PR[44] Final Loading Position ;
  67:  CALL CREATE_PR(44,167.886,(-62.489),311.377,150.836,89.177,149.22) ;
  68:  !PR[53] pre-Unloading Position ;
  69:  CALL CREATE_PR(53,(-130.481),93.166,172.006,168.789,(-88.281),(-170.136)) ;
  70:  !PR[54] Final Unloading Position ;
  71:  CALL CREATE_PR(54,(-128.735),93.392,117.767,169.08,(-88.268),(-170.429)) ;
  72:  !PR[56] assitant Unloading preses ;
  73:  CALL CREATE_PR(56,(-133.84),95.467,273.686,(-177.134),(-88.249),175.184) ;
  74:  !PR[57] assitant Unloading preses ;
  75:  CALL CREATE_PR(57,(-135.964),108.085,344.284,(-177.144),(-88.245),175.194) ;
  76:  !PR[58] assitant Unloading preses ;
  77:  CALL CREATE_PR(58,296.854,360.959,378.47,(-91.75),(-.28),88.063) ;
  78:  ENDIF ;
  79:  !---------------------------- ;
  80:  !SR[1] = "JOB_VAR_ID_GRIP" ;
  81:  !JOB_VAR_COMMON(R[103])'s value ;
  82:  !---------------------------- ;
  83:  !2By3 SR[1] INF, Max 18(Straight) ;
  84:  !R[103]=100 ;
  85:  !2By3 INF 45 Degree Diagonal Shif ;
  86:  !R[103]=110 ;
  87:  !---------------------------- ;
  88:  !3By4 SR[1] INF, Max 36(Straight) ;
  89:  !R[103]=150 ;
  90:  !3By4 INF 45 Degree Diagonal Shif ;
  91:  !R[103]=160 ;
  92:  !---------------------------- ;
  93:  !R[103] "JOB_PROFILE" Selection ;
  94:  R[103]=100 ;
  95:  CALL JOB_VAR_COMMON(R[103]) ;
  96:  ENDIF ;
  97:  LBL[9999] ;
/POS
/END
