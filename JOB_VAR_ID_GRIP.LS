/PROG  JOB_VAR_ID_GRIP
/ATTR
OWNER        = MNEDITOR;
COMMENT      = "";
PROG_SIZE    = 0;
CREATE       = DATE 19-07-31  TIME 17:01:20;
MODIFIED     = DATE 26-07-17  TIME 17:40:38;
FILE_NAME    = JOB_VARI;
VERSION      = 0;
LINE_COUNT   = 96;
MEMORY_SIZE  = 0;
PROTECT      = READ_WRITE;
TCD:  STACK_SIZE     = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE    = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP = 1,*,*,*,*;
CONTROL_CODE  = 00000000 00000000;
/APPL
AUTO_SINGULARITY_HEADER;
ENABLE_SINGULARITY_AVOIDANCE : TRUE;
/MN
   1:  !R[70] is the item number ;
   2:  !R[71] if using previous data ;
   3:  R[196]=AR[1] ;
   4:  R[197]=AR[2] ;
   5:  !------------------------- ;
   6:  !Item Select = 1111199990 ;
   7:  SELECT R[196]=9990,JMP LBL[9990] ;
   8:         ELSE,JMP LBL[9999] ;
   9:  LBL[9990] ;
  10:  !--------------------------- ;
  11:  !KAREL PROGRAM ;
  12:  !Item 1111199990 ;
  13:  !Last Modified: 2026-Sep-17 ;
  14:  !Modified by: Erfan ;
  15:  !--------------------------- ;
  16:  IF (R[70]=9990) THEN ;
  17:    !Define Parameters for INF/OTF ;
  18:    !R[105]=AR[1]=100, 2By3 Sheet ;
  19:    !R[105]=AR[1]=200, 3By4 Sheet ;
  20:    CALL JOB_VAR_SETUP(100) ;
  21:    CALL GN_CLS_SC_F9 ;
  22:    MESSAGE[ID GRIPPING STARTS] ;
  23:    WAIT 3.00(sec) ;
  24:    !--------------------------- ;
  25:    !Define Parameters for Job ;
  26:    R[1]=1 ;
  27:    R[2]=0 ;
  28:    R[4]=0 ;
  29:    R[67]=40 ;
  30:    !R[85] "INF_JAW_OFFSET"(Hgt) ;
  31:    R[85:INF_JAW_OFFSET]=R[417] ;
  32:    !R[86] "INF_PICK_OFFSET" 50mm/sec ;
  33:    R[86:INF_PICK_OFFSET]=R[702] ;
  34:    !R[87] "MAIN_LOAD_OFFSET" (PRELOA ;
  35:    R[87]=0 ;
  36:    !R[100] "GRIPPER_ID" 3 values ;
  37:    !If =100, ID Grippers Installed ;
  38:    !If =200, OD Grippers Installed ;
  39:    R[100:GRIPPER_ID]=100 ;
  40:    !--------------------------- ;
  41:    !If using previous setup data ;
  42:    IF (R[71]=9990) THEN ;
  43:      !--------------------------- ;
  44:      !1st: Height of Raw piece ;
  45:      R[190:Hgt_Raw_piece]=R[410] +(-325) ;
  46:      !2nd: Height of Finish piece ;
  47:      R[191]=0 ;
  48:      !3rd: Infeed Height Offset ;
  49:      R[192:Infeed Height Offset]=R[701] ;
  50:      !4th: Outfeed Height Offset ;
  51:      R[193]=(-235) ;
  52:      !--------------------------- ;
  53:      CALL CREATE_REG(R[190],R[191],R[192],R[193]) ;
  54:    ENDIF ;
  55:    !If new loading or offloading pos ;
  56:    !SET R[104] "IMPORT_LOADPOS" ;
  57:    !SET R[104]=1000, Otherwise NO ;
  58:    R[104]=1000 ;
  59:    IF (R[104]=1000) THEN ;
  60:      !R[260]=43, Preload Pos1 ;
  61:      !R[270]=44, Preload PosFinal ;
  62:      !R[300]=53, Offload PosFinal ;
  63:      !PR[43] Pre-Loading Pos1 ;
  64:      CALL CREATE_PR(43,165.86,(-61.611),145.429,150.192,89.173,148.558) ;
  65:      !PR[44] Final Loading Position ;
  66:      CALL CREATE_PR(44,167.886,(-62.489),311.377,150.836,89.177,149.22) ;
  67:      !PR[53] pre-Unloading Position ;
  68:      CALL CREATE_PR(53,(-130.481),93.166,172.006,168.789,(-88.281),(-170.136)) ;
  69:      !PR[54] Final Unloading Position ;
  70:      CALL CREATE_PR(54,(-128.735),93.392,117.767,169.08,(-88.268),(-170.429)) ;
  71:      !PR[56] assitant Unloading preses ;
  72:      CALL CREATE_PR(56,(-133.84),95.467,273.686,(-177.134),(-88.249),175.184) ;
  73:      !PR[57] assitant Unloading preses ;
  74:      CALL CREATE_PR(57,(-135.964),108.085,344.284,(-177.144),(-88.245),175.194) ;
  75:      !PR[58] assitant Unloading preses ;
  76:      CALL CREATE_PR(58,296.854,360.959,378.47,(-91.75),(-.28),88.063) ;
  77:    ENDIF ;
  78:    !---------------------------- ;
  79:    !SR[1] = "JOB_VAR_ID_GRIP" ;
  80:    !JOB_VAR_COMMON(R[103])'s value ;
  81:    !---------------------------- ;
  82:    !2By3 SR[1] INF, Max 18(Straight) ;
  83:    !R[103]=100 ;
  84:    !2By3 INF 45 Degree Diagonal Shif ;
  85:    !R[103]=110 ;
  86:    !---------------------------- ;
  87:    !3By4 SR[1] INF, Max 36(Straight) ;
  88:    !R[103]=150 ;
  89:    !3By4 INF 45 Degree Diagonal Shif ;
  90:    !R[103]=160 ;
  91:    !---------------------------- ;
  92:    !R[103] "JOB_PROFILE" Selection ;
  93:    R[103]=100 ;
  94:    CALL JOB_VAR_COMMON(R[103]) ;
  95:  ENDIF ;
  96:  LBL[9999] ;
/POS
/END
