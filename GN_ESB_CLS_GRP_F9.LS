/PROG  GN_ESB_CLS_GRP_F9
/ATTR
OWNER		= MNEDITOR;
COMMENT		= "CLOSING GRIPPER";
PROG_SIZE	= 3071;
CREATE		= DATE 24-04-26  TIME 08:00:00;
MODIFIED	= DATE 24-04-26  TIME 08:00:00;
FILE_NAME	= GN_ESB_CLS_GRP_F9;
VERSION		= 0;
LINE_COUNT	= 100;
MEMORY_SIZE	= 3515;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL

AUTO_SINGULARITY_HEADER;
  ENABLE_SINGULARITY_AVOIDANCE   : TRUE;
/MN
	1: ! Close the gripper ;
	2: RO[1]=ON ;
	3: WAIT 0.50(sec) ;
	4: ! ------------------------------
	5: ! Check closed sensor ;
	6: IF (RI[2]=ON) THEN ;
	7: 	MESSAGE[GRIPPER FAILED TO CLOSE] ;
	8:    !ABORT:
	9: ENDIF;
/POS
/END
